import { DB } from './db.js';
import { generateId } from './helper.js';

export const Activity = {
    log: async (userId, type, detail) => {
        const entry = { id: generateId(), userId, type, detail, timestamp: new Date().toISOString() };
        await DB.add('activity', entry);
    },
    getAllByUser: async (userId) => {
        const logs = await DB.getAll('activity');
        return logs.filter(l => l.userId === userId).sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
    }
};
